model CivitaiItemTag {
  id String @id @default(cuid(2)) @db.VarChar(30)

  civitaiItemId Int    @map("civitai_item_id")
  civitaiTagId  String @map("civitai_tag_id")

  item CivitaiItem @relation(fields: [civitaiItemId], references: [id])
  tag  CivitaiTag  @relation(fields: [civitaiTagId], references: [id])

  @@map("civitai_item_tags")
}
